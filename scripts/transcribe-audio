#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "usage: transcribe-audio <local-audio-path> [language] [output-markdown]" >&2
  exit 2
fi

audio_path="$1"
language="${2:-}"
output_path="${3:-}"

if [[ ! -f "$audio_path" ]]; then
  echo "audio file not found or not a regular file: $audio_path" >&2
  exit 2
fi

audio_dir="$(cd "$(dirname "$audio_path")" && pwd -P)"
audio_file="$audio_dir/$(basename "$audio_path")"

if [[ -n "${CODEX_ASR_BIN:-}" ]]; then
  codex_asr="$CODEX_ASR_BIN"
elif command -v codex-asr >/dev/null 2>&1; then
  codex_asr="$(command -v codex-asr)"
else
  echo "codex-asr is not installed or not available on PATH" >&2
  echo "install it from https://github.com/Wangnov/codex-asr" >&2
  exit 127
fi

if [[ ! -x "$codex_asr" ]]; then
  echo "codex-asr is not executable: $codex_asr" >&2
  exit 127
fi

request_timeout="${TRANSCRIBE_AUDIO_REQUEST_TIMEOUT_SECONDS:-900}"
connect_timeout="${TRANSCRIBE_AUDIO_CONNECT_TIMEOUT_SECONDS:-15}"
chunk_seconds="${TRANSCRIBE_AUDIO_CHUNK_SECONDS:-600}"
max_attempts="${TRANSCRIBE_AUDIO_MAX_ATTEMPTS:-2}"

if ! [[ "$max_attempts" =~ ^[1-9][0-9]*$ ]]; then
  echo "TRANSCRIBE_AUDIO_MAX_ATTEMPTS must be a positive integer" >&2
  exit 2
fi

if [[ -n "$output_path" && -e "$output_path" ]]; then
  echo "output already exists; choose a new path: $output_path" >&2
  exit 2
fi

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/anc-transcribe-audio.XXXXXX")"
cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT INT TERM

transcribe_one() {
  local input_file="$1"
  local transcript_file="$2"
  local error_file="$3"
  local attempt=1
  local args=(
    "$input_file"
    --request-timeout-seconds "$request_timeout"
    --connect-timeout-seconds "$connect_timeout"
  )
  if [[ -n "$language" ]]; then
    args+=(--language "$language")
  fi

  while (( attempt <= max_attempts )); do
    if "$codex_asr" "${args[@]}" >"$transcript_file" 2>"$error_file"; then
      return 0
    fi
    if (( attempt < max_attempts )); then
      echo "transcription attempt ${attempt} failed for $(basename "$input_file"); retrying" >&2
    fi
    attempt=$((attempt + 1))
  done

  echo "transcription failed after ${max_attempts} attempt(s) for $(basename "$input_file")" >&2
  if [[ -s "$error_file" ]]; then
    sed -n '1,12p' "$error_file" >&2
  fi
  return 1
}

duration=""
if command -v ffprobe >/dev/null 2>&1; then
  duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$audio_file" 2>/dev/null || true)"
fi

needs_split=0
if [[ "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  if awk -v duration="$duration" -v limit="$chunk_seconds" 'BEGIN { exit !(duration > limit) }'; then
    needs_split=1
  fi
fi

inputs=("$audio_file")
if [[ "$needs_split" -eq 1 ]]; then
  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "audio is longer than ${chunk_seconds} seconds and ffmpeg is not installed" >&2
    exit 127
  fi

  chunk_dir="$work_dir/chunks"
  mkdir -p "$chunk_dir"
  echo "audio is ${duration}s; splitting locally into ${chunk_seconds}s chunks" >&2
  ffmpeg -hide_banner -loglevel error -i "$audio_file" \
    -f segment -segment_time "$chunk_seconds" -reset_timestamps 1 \
    -ac 1 -ar 16000 -c:a pcm_s16le "$chunk_dir/chunk-%04d.wav"

  inputs=()
  for chunk in "$chunk_dir"/chunk-*.wav; do
    [[ -f "$chunk" ]] || continue
    inputs+=("$chunk")
  done
  if [[ ${#inputs[@]} -eq 0 ]]; then
    echo "ffmpeg did not produce any audio chunks" >&2
    exit 1
  fi
fi

transcript_files=()
index=0
for input_file in "${inputs[@]}"; do
  transcript_file="$work_dir/transcript-$(printf '%04d' "$index").txt"
  error_file="$work_dir/error-$(printf '%04d' "$index").txt"
  echo "transcribing part $((index + 1)) of ${#inputs[@]}" >&2
  transcribe_one "$input_file" "$transcript_file" "$error_file"
  transcript_files+=("$transcript_file")
  index=$((index + 1))
done

combined_transcript="$work_dir/complete-transcript.txt"
: >"$combined_transcript"
index=0
for transcript_file in "${transcript_files[@]}"; do
  if (( index > 0 )); then
    printf '\n\n' >>"$combined_transcript"
  fi
  cat "$transcript_file" >>"$combined_transcript"
  index=$((index + 1))
done

if [[ -z "$output_path" ]]; then
  cat "$combined_transcript"
  printf '\n'
  exit 0
fi

output_dir="$(dirname "$output_path")"
mkdir -p "$output_dir"
output_dir="$(cd "$output_dir" && pwd -P)"
output_file="$output_dir/$(basename "$output_path")"
if [[ -e "$output_file" ]]; then
  echo "output already exists; choose a new path: $output_file" >&2
  exit 2
fi

source_name="$(basename "$audio_file")"
title="${source_name%.*}"
duration_label="unknown"
if [[ "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  duration_label="$(awk -v seconds="$duration" 'BEGIN { total=int(seconds+0.5); printf "%02d:%02d:%02d", int(total/3600), int((total%3600)/60), total%60 }')"
fi
language_label="auto"
if [[ -n "$language" ]]; then
  language_label="$language"
fi

markdown_tmp="$(mktemp "$output_dir/.anc-transcribe-audio.XXXXXX")"
{
  printf '# %s — 原文稿\n\n' "$title"
  printf -- '- Source: %s\n' "$source_name"
  printf -- '- Duration: %s\n' "$duration_label"
  printf -- '- Language hint: %s\n' "$language_label"
  printf -- '- Generated by: ANC Transcribe Audio\n\n'
  printf '## Transcript\n\n'
  cat "$combined_transcript"
  printf '\n'
} >"$markdown_tmp"

mv "$markdown_tmp" "$output_file"
printf '%s\n' "$output_file"
